  220    00:E40A  98         			tya
  221    00:E40B  E5 00      			sbc.l	<divisor
  222    00:E40D  38         			sec				
  223    00:E40E  80 E5      			bra	.loop
  224                        	
  225    00:E410  A4 93      	.finished:	ldy.h	<remainder		; Get the remainder hi-byte.
