         01:C810  20 40 80 80 
  436    01:C814  20 20 20 20	.height:	db	$20,$20,$20,$20,$40,$40,$40,$40
         01:C818  40 40 40 40 
  437    01:C81C  03 07 0F 0F	.limit:		db	$03,$07,$0F,$0F,$07,$0F,$1F,$1F
         01:C820  07 0F 1F 1F 
