   92    01:CA4B  20 77 FF   			call	set_mode_vdc
   93                        	
   94               0000     		.if	SUPPORT_SGX
   96                        		.endif
   97    01:CA4E  2C 00 02   			bit	VDC_SR			; Purge any overdue VBL.
