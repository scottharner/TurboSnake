  210                        	; **************
  211                        	; 16-bytes of VDC HuC map info.
  212                        	;
  213                        	; N.B. MUST be 16-bytes before the SGX versions to use PCE_VDC_OFFSET.
  214                        	
  215                        	; Initialized by set_map_data()
  216    F8:257F             	vdc_map_wrap	ds	1			; unused
  217    F8:2580             	vdc_map_bank	ds	1
