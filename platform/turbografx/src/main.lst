  487                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 9; ; Based on the original HuC and MagicKit functions by David Michel and the
  488                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 10; ; other original HuC developers.
  489                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 11; ;
