  357    01:CAC1  68         	!:		pla				; Restore MPR3 and MPR4.
  358    01:CAC2  53 10      			tam4
  359    01:CAC4  68         			pla
  360    01:CAC5  53 08      			tam3
  361                        	
  362                        			leave				; Return and copy X -> A.
         01:CAC7  4C EF FF   			jmp	leave_proc
