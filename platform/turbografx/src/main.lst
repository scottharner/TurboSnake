  498                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 20; ;
  499                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 21; ; HuC's old scrolling library is provided for use with existing HuC projects,
  500                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 22; ; but it should preferably be avoided in new projects because it is slow and
  501                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 23; ; forever limited by its choice to handle gaps between areas, and sorting.
  502                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 24; ;
  503                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 25; ; HuCC's new scrolling library puts the responibility for defining both gaps
  504                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 26; ; and the display order into the project's hands, but in return it runs much
  505                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 27; ; faster, using less than 1/6 of the processing time in VBLANK, and far less
  506                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 28; ; time in the RCR interrputs themselves. It also supports the 2nd SuperGRAFX
  507                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 29; ; screen layer, which HuC's old scrolling library ignores.
  508                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 30; ;
  509                        		.dbg	line,	"\huc\include\hucc\hucc-old-scroll.h", 31; ; ***************************************************************************
