  167    01:CAE0  3A         			dec	a
  168    01:CAE1  D0 F4      			bne	.clr_loop
  169                        	
  170                        			leave				; All done, phew!
         01:CAE3  4C EF FF   			jmp	leave_proc
  171                        	
  172                        			.endp
